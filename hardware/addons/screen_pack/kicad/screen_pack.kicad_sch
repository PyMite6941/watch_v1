	)
	(text "Most 0.91\" (128x32) and 0.96\" (128x64)\nSSD1306 I2C modules: GND VCC SCL SDA.\nFit a 4-pin female header in ONE row:\nthe one whose order matches the module."
		(exclude_from_sim no)
		(at 96.52 88.9 0)
		(effects

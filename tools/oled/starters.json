    ]},
    {"name": "Focus steps", "for": "app", "items": [
      {"k": "text", "s": "{title}", "f": 3, "x": 0, "y": 13},
      {"k": "text", "s": "Step {step}", "f": 0, "a": "r", "x": 128, "y": 12, "mw": 64, "if": "step"},
      {"k": "text", "s": "{value}", "f": [5, 4, 0], "a": "c", "x": 64, "y": 48, "mw": 128},
      {"k": "bar", "v": "{step_pct}", "x": 0, "y": 56, "w": 128, "h": 8, "r": 3}
    ]}
  ]

      {"k": "bar", "v": "{sec_pct}", "x": 0, "y": 0, "w": 128, "h": 2, "o": 0}
    ]},
    {"name": "Class bell", "for": "period", "items": [
      {"k": "icon", "n": "bell", "z": 32, "x": 48, "y": 0},
      {"k": "text", "s": "{bell}", "f": [5, 4, 3], "a": "c", "x": 64, "y": 62, "mw": 128, "if": "bell"},
      {"k": "text", "s": "No more bells", "f": [3, 2, 0], "a": "c", "x": 64, "y": 54, "mw": 128, "if": "!bell"}
    ]},
    {"name": "Name badge", "for": "time", "items": [
      {"k": "box", "x": 0, "y": 0, "w": 128, "h": 46, "r": 6, "fill": 1},
      {"k": "text", "s": "{name}", "f": [5, 4, 3, 0], "a": "c", "x": 64, "y": 32, "mw": 120, "c": 0},
      {"k": "text", "s": "{time}", "f": [3, 0], "a": "c", "x": 64, "y": 62}
    ]},
    {"name": "Weather", "for": "weather", "items": [
      {"k": "icon", "n": "{wx_icon}", "z": 32, "x": 0, "y": 4},
      {"k": "text", "s": "{wx_temp}", "f": [5, 4, 0], "x": 40, "y": 30, "mw": 88},
      {"k": "text", "s": "{wx}", "f": [2, 0], "x": 0, "y": 52, "mw": 128},

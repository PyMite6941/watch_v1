      {"k": "battery", "x": 102, "y": 0, "w": 26, "h": 9},
      {"k": "line", "x": 0, "y": 12, "x2": 127, "y2": 12},
      {"k": "text", "s": "{time}", "f": [6, 5, 4], "a": "c", "x": 62, "y": 48, "mw": 116},
      {"k": "text", "s": "{ampm}", "f": 1, "a": "r", "x": 89, "y": 7, "if": "ampm"},

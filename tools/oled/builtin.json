{
  "_about": "The watch's own OLED screens, one set per panel size. 'time' is the clock, 'card' every other screen (value + label), 'overlay' the short flash after a button press. A file in /oled on the watch with the same 'for' replaces one. Format: docs/OLED_SCREENS.md. After editing run: python tools/oled/build_assets.py",
  "128x32": {
    "time": {"name": "Clock", "items": [
      {"k": "text", "s": "{time}", "f": [5, 4, 3], "x": 0, "y": 28, "mw": 90},
      {"k": "text", "s": "{dy} {dd}", "f": 1, "u": 1, "a": "c", "x": 111, "y": 6},
      {"k": "icon", "n": "{wx_icon}", "z": 8, "x": 93, "y": 10, "if": "wx_temp"},
      {"k": "text", "s": "{wx_temp}", "f": 0, "x": 103, "y": 17, "mw": 25, "if": "wx_temp"},
      {"k": "battery", "x": 98, "y": 22, "w": 26, "h": 9},
      {"k": "icon", "n": "bolt", "z": 8, "x": 89, "y": 23, "if": "charging"}
    ]},
    "card": {"name": "Card", "items": [
      {"k": "icon", "n": "{icon}", "z": 16, "x": 0, "y": 2},
      {"k": "text", "s": "{value}", "f": [4, 3, 2, 0], "a": "c", "x": 72, "y": 19, "mw": 108},
      {"k": "text", "s": "{label}", "f": 0, "a": "c", "x": 72, "y": 31, "mw": 110}
    ]},
    "overlay": {"name": "Flash", "items": [
      {"k": "text", "s": "{value}", "f": [5, 4, 3, 0], "a": "c", "x": 64, "y": 28, "mw": 128}
    ]}
  },
  "128x64": {
